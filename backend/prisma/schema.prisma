generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LoteStatus {
  DISPONIVEL
  RESERVADO
  VENDIDO
}

enum ContratoStatus {
  ATIVO
  QUITADO
  CANCELADO
}

enum ParcelaStatus {
  PENDENTE
  PAGO
  ATRASADO
}

model User {
  id           String     @id @default(cuid())
  nome         String
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  contratos    Contrato[]
}

model Quadra {
  id        String   @id @default(cuid())
  nome      String   @unique
  lotes     Lote[]
  createdAt DateTime @default(now())
}

model Lote {
  id              String     @id @default(cuid())
  numero          String
  metragem        Decimal    @db.Decimal(10, 2)
  valor           Decimal    @db.Decimal(12, 2)
  status          LoteStatus @default(DISPONIVEL)
  quadraId        String
  quadra          Quadra     @relation(fields: [quadraId], references: [id], onDelete: Cascade)
  contrato        Contrato?
  reservaExpiraEm DateTime?
  createdAt       DateTime   @default(now())

  @@unique([quadraId, numero])
}

model Cliente {
  id              String     @id @default(cuid())
  nome            String
  cpf             String     @unique
  telefone        String
  email           String?
  logradouro      String?
  numeroEndereco  String?
  bairro          String?
  complemento     String?
  cep             String?
  cidade          String?
  estado          String?
  createdAt       DateTime   @default(now())
  contratos       Contrato[]
}

model Contrato {
  id          String         @id @default(cuid())
  clienteId   String
  cliente     Cliente        @relation(fields: [clienteId], references: [id])
  loteId      String         @unique
  lote        Lote           @relation(fields: [loteId], references: [id])
  vendedorId  String
  vendedor    User           @relation(fields: [vendedorId], references: [id])
  valorTotal  Decimal        @db.Decimal(12, 2)
  entrada     Decimal        @db.Decimal(12, 2)
  numParcelas Int
  dataVenda   DateTime       @default(now())
  status      ContratoStatus @default(ATIVO)
  createdAt   DateTime       @default(now())
  parcelas    Parcela[]
}

model Parcela {
  id         String        @id @default(cuid())
  contratoId String
  contrato   Contrato      @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numero     Int
  valor      Decimal       @db.Decimal(12, 2)
  vencimento DateTime
  status     ParcelaStatus @default(PENDENTE)
  pagoEm     DateTime?
  valorPago  Decimal?      @db.Decimal(12, 2)
  multa      Decimal?      @db.Decimal(12, 2)

  @@unique([contratoId, numero])
}
